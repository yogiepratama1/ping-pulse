---
/**
 * Modal.astro — Cyber-Brutalist testing terminal overlay
 * Handles card clicks, hacker sequence animation, and ping API calls
 */
---

<div id="ping-modal" class="modal" aria-hidden="true">
    <div class="modal__backdrop"></div>
    <div class="modal__container">
        <div class="modal__header">
            <div class="modal__title-row">
                <span class="modal__icon">◉</span>
                <h2 id="modal-title" class="modal__title">TARGET</h2>
                <button
                    id="modal-close"
                    class="modal__close"
                    aria-label="Close modal">✕</button
                >
            </div>
            <div class="modal__meta">
                <span id="modal-region" class="modal__region">REGION</span>
                <span id="modal-type" class="modal__type-badge">TYPE</span>
            </div>
        </div>

        <div class="modal__terminal">
            <div class="modal__terminal-header">
                <span class="modal__terminal-dot modal__terminal-dot--red"
                ></span>
                <span class="modal__terminal-dot modal__terminal-dot--yellow"
                ></span>
                <span class="modal__terminal-dot modal__terminal-dot--green"
                ></span>
                <span class="modal__terminal-label">ping-pulse-terminal</span>
            </div>
            <div id="modal-output" class="modal__output">
                <p class="modal__output-line">READY_</p>
            </div>
        </div>

        <div id="modal-result" class="modal__result" style="display: none;">
            <div class="modal__result-grid">
                <div class="modal__result-item">
                    <span class="modal__result-label">AVG</span>
                    <span id="result-latency" class="modal__result-value"
                        >--</span
                    >
                </div>
                <div class="modal__result-item">
                    <span class="modal__result-label">MIN</span>
                    <span
                        id="result-min"
                        class="modal__result-value modal__result-value--small"
                        >--</span
                    >
                </div>
                <div class="modal__result-item">
                    <span class="modal__result-label">MAX</span>
                    <span
                        id="result-max"
                        class="modal__result-value modal__result-value--small"
                        >--</span
                    >
                </div>
                <div class="modal__result-item">
                    <span class="modal__result-label">STATUS</span>
                    <span
                        id="result-status"
                        class="modal__result-value modal__result-value--small"
                        >--</span
                    >
                </div>
            </div>
            <div id="result-pings" class="modal__pings"></div>
        </div>

        <button id="modal-test-btn" class="modal__test-btn">
            ▶ TEST CONNECTION
        </button>
    </div>
</div>

<script>
    const modal = document.getElementById("ping-modal") as HTMLDivElement;
    const modalTitle = document.getElementById(
        "modal-title",
    ) as HTMLHeadingElement;
    const modalRegion = document.getElementById(
        "modal-region",
    ) as HTMLSpanElement;
    const modalType = document.getElementById("modal-type") as HTMLSpanElement;
    const modalOutput = document.getElementById(
        "modal-output",
    ) as HTMLDivElement;
    const modalResult = document.getElementById(
        "modal-result",
    ) as HTMLDivElement;
    const resultLatency = document.getElementById(
        "result-latency",
    ) as HTMLSpanElement;
    const resultMin = document.getElementById("result-min") as HTMLSpanElement;
    const resultMax = document.getElementById("result-max") as HTMLSpanElement;
    const resultStatus = document.getElementById(
        "result-status",
    ) as HTMLSpanElement;
    const resultPings = document.getElementById(
        "result-pings",
    ) as HTMLDivElement;
    const testBtn = document.getElementById(
        "modal-test-btn",
    ) as HTMLButtonElement;
    const closeBtn = document.getElementById(
        "modal-close",
    ) as HTMLButtonElement;
    const backdrop = modal.querySelector(".modal__backdrop") as HTMLDivElement;

    let currentUrl = "";
    let currentType = "";
    let hackerInterval: ReturnType<typeof setInterval> | null = null;

    const hackerPhrases = [
        "INITIALIZING QUANTUM ROUTING...",
        "BYPASSING MAINFRAME FIREWALL...",
        "DECRYPTING PACKET HEADERS...",
        "TUNNELING THROUGH DARK WEB...",
        "CALIBRATING PHOTON STREAMS...",
        "AUTHENTICATING NEURAL LINK...",
        "MAPPING NETWORK TOPOLOGY...",
        "RESOLVING DNS BLACKHOLES...",
        "ESTABLISHING SECURE TUNNEL...",
        "SYNCHRONIZING TIME CRYSTALS...",
    ];

    function openModal(
        name: string,
        region: string,
        type: string,
        url: string,
    ) {
        currentUrl = url;
        currentType = type;
        modalTitle.textContent = name;
        modalRegion.textContent = `⌘ ${region}`;
        modalType.textContent = type === "game" ? "▸ GAME" : "▸ API";
        modalType.className = `modal__type-badge modal__type-badge--${type}`;
        modalOutput.innerHTML = '<p class="modal__output-line">READY_</p>';
        modalResult.style.display = "none";
        testBtn.disabled = false;
        testBtn.textContent = "▶ TEST CONNECTION";
        modal.classList.add("modal--active");
        modal.setAttribute("aria-hidden", "false");
    }

    function closeModal() {
        modal.classList.remove("modal--active");
        modal.setAttribute("aria-hidden", "true");
        if (hackerInterval) {
            clearInterval(hackerInterval);
            hackerInterval = null;
        }
    }

    function startHackerSequence() {
        let index = 0;
        modalOutput.innerHTML = "";
        hackerInterval = setInterval(() => {
            const line = document.createElement("p");
            line.className = "modal__output-line modal__output-line--active";
            line.textContent = `> ${hackerPhrases[index % hackerPhrases.length]}`;
            modalOutput.appendChild(line);
            modalOutput.scrollTop = modalOutput.scrollHeight;
            index++;
        }, 400);
    }

    function getColorClass(status: string) {
        if (status === "Healthy") return "modal__result-value--green";
        if (status === "Degraded") return "modal__result-value--yellow";
        return "modal__result-value--red";
    }

    function showResult(data: {
        latency: number;
        min: number;
        max: number;
        pings: number[];
        status: string;
    }) {
        if (hackerInterval) {
            clearInterval(hackerInterval);
            hackerInterval = null;
        }

        // Final line
        const doneLine = document.createElement("p");
        doneLine.className = "modal__output-line modal__output-line--done";
        doneLine.textContent = `> 10 PINGS COMPLETE. AVG: ${data.latency}ms`;
        modalOutput.appendChild(doneLine);
        modalOutput.scrollTop = modalOutput.scrollHeight;

        // Populate stats
        const colorCls = getColorClass(data.status);
        resultLatency.textContent = `${data.latency}ms`;
        resultLatency.className = `modal__result-value ${colorCls}`;
        resultMin.textContent = `${data.min}ms`;
        resultMin.className = `modal__result-value modal__result-value--small ${colorCls}`;
        resultMax.textContent = `${data.max}ms`;
        resultMax.className = `modal__result-value modal__result-value--small ${colorCls}`;
        resultStatus.textContent = data.status;
        resultStatus.className = `modal__result-value modal__result-value--small ${colorCls}`;

        // Ping bar chart
        const maxPing = Math.max(...data.pings, 1);
        resultPings.innerHTML = data.pings
            .map((p, i) => {
                const pct = Math.max((p / maxPing) * 100, 4);
                return `<div class="modal__ping-bar-wrap"><div class="modal__ping-bar" style="height:${pct}%"></div><span class="modal__ping-num">${p}</span></div>`;
            })
            .join("");

        modalResult.style.display = "block";
        testBtn.disabled = false;
        testBtn.textContent = "▶ TEST AGAIN";
    }

    // Card click delegation
    document.addEventListener("click", (e) => {
        const card = (e.target as HTMLElement).closest(
            ".card",
        ) as HTMLElement | null;
        if (card) {
            e.preventDefault();
            const url = card.dataset.url ?? "";
            const type = card.dataset.type ?? "";
            const name = card.dataset.name ?? "";
            const region = card.dataset.region ?? "";
            openModal(name, region, type, url);
        }
    });

    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
    });

    testBtn.addEventListener("click", async () => {
        testBtn.disabled = true;
        testBtn.textContent = "⟳ TESTING...";
        modalResult.style.display = "none";
        startHackerSequence();

        try {
            const res = await fetch("/api/ping", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ url: currentUrl, type: currentType }),
            });
            const data = await res.json();
            // Small delay for dramatic effect
            setTimeout(() => {
                showResult(data);
            }, 1200);
        } catch {
            setTimeout(() => {
                showResult({
                    latency: 9999,
                    min: 9999,
                    max: 9999,
                    pings: [],
                    status: "Error",
                });
            }, 800);
        }
    });
</script>

<style>
    .modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
    }

    .modal--active {
        opacity: 1;
        pointer-events: auto;
    }

    .modal__backdrop {
        position: absolute;
        inset: 0;
        background: var(--color-bg-modal);
        backdrop-filter: blur(6px);
    }

    .modal__container {
        position: relative;
        width: 90%;
        max-width: 560px;
        background: var(--color-bg-primary);
        border: 4px solid var(--color-neon-cyan);
        box-shadow:
            0 0 20px rgba(0, 255, 245, 0.3),
            0 0 60px rgba(0, 255, 245, 0.1),
            inset 0 0 20px rgba(0, 255, 245, 0.05);
        padding: 0;
        overflow: hidden;
    }

    .modal__header {
        padding: 1.2rem 1.5rem 0.8rem;
        border-bottom: 2px solid rgba(0, 255, 245, 0.2);
    }

    .modal__title-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .modal__icon {
        color: var(--color-neon-cyan);
        font-size: 1rem;
        animation: pulse-glow 2s ease-in-out infinite;
    }

    .modal__title {
        font-family: var(--font-mono);
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin: 0;
        flex: 1;
    }

    .modal__close {
        background: none;
        border: 2px solid var(--color-neon-red);
        color: var(--color-neon-red);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        cursor: pointer;
        padding: 0.2rem 0.5rem;
        transition: all 0.15s ease;
    }

    .modal__close:hover {
        background: var(--color-neon-red);
        color: #000;
    }

    .modal__meta {
        display: flex;
        gap: 0.8rem;
        margin-top: 0.5rem;
    }

    .modal__region {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        color: var(--color-neon-cyan);
        letter-spacing: 0.2em;
        opacity: 0.8;
    }

    .modal__type-badge {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        padding: 0.1rem 0.4rem;
        border: 1px solid;
    }

    .modal__type-badge--game {
        color: var(--color-neon-green);
        border-color: var(--color-neon-green);
    }

    .modal__type-badge--api {
        color: var(--color-neon-magenta);
        border-color: var(--color-neon-magenta);
    }

    .modal__terminal {
        margin: 1rem 1.5rem;
        border: 2px solid rgba(0, 255, 245, 0.3);
        background: rgba(0, 0, 0, 0.5);
    }

    .modal__terminal-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.6rem;
        background: rgba(0, 255, 245, 0.05);
        border-bottom: 1px solid rgba(0, 255, 245, 0.15);
    }

    .modal__terminal-dot {
        width: 8px;
        height: 8px;
    }

    .modal__terminal-dot--red {
        background: var(--color-neon-red);
    }
    .modal__terminal-dot--yellow {
        background: var(--color-neon-yellow);
    }
    .modal__terminal-dot--green {
        background: var(--color-neon-green);
    }

    .modal__terminal-label {
        font-family: var(--font-mono);
        font-size: 0.55rem;
        color: var(--color-neon-cyan);
        opacity: 0.5;
        margin-left: 0.4rem;
        letter-spacing: 0.1em;
    }

    .modal__output {
        padding: 0.8rem;
        max-height: 180px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--color-neon-cyan) transparent;
    }

    .modal__output-line {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-neon-cyan);
        margin: 0 0 0.3rem;
        opacity: 0.7;
    }

    .modal__output-line--active {
        color: var(--color-neon-green);
        opacity: 1;
        animation: text-flicker 0.5s ease;
    }

    .modal__output-line--done {
        color: var(--color-neon-yellow);
        font-weight: 700;
        opacity: 1;
    }

    .modal__result {
        margin: 0 1.5rem 1rem;
        border: 2px solid var(--color-neon-cyan);
        padding: 1rem;
    }

    .modal__result-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.8rem;
        text-align: center;
    }

    .modal__result-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .modal__result-label {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--color-neon-cyan);
        letter-spacing: 0.2em;
        opacity: 0.6;
    }

    .modal__result-value {
        font-family: var(--font-mono);
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: 0.05em;
    }

    .modal__result-value--small {
        font-size: 1rem;
    }

    .modal__result-value--green {
        color: var(--color-neon-green);
        text-shadow: 0 0 10px rgba(57, 255, 20, 0.5);
    }

    .modal__result-value--yellow {
        color: var(--color-neon-yellow);
        text-shadow: 0 0 10px rgba(255, 255, 0, 0.5);
    }

    .modal__result-value--red {
        color: var(--color-neon-red);
        text-shadow: 0 0 10px rgba(255, 0, 64, 0.5);
    }

    .modal__pings {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        height: 60px;
        margin-top: 0.8rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(0, 255, 245, 0.15);
    }

    .modal__ping-bar-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
    }

    .modal__ping-bar {
        width: 100%;
        background: var(--color-neon-cyan);
        min-height: 2px;
        transition: height 0.3s ease;
    }

    .modal__ping-num {
        font-family: var(--font-mono);
        font-size: 0.45rem;
        color: var(--color-neon-cyan);
        margin-top: 2px;
        opacity: 0.6;
    }

    .modal__test-btn {
        display: block;
        width: calc(100% - 3rem);
        margin: 0 1.5rem 1.5rem;
        padding: 0.8rem;
        background: transparent;
        border: 3px solid var(--color-neon-cyan);
        color: var(--color-neon-cyan);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .modal__test-btn:hover:not(:disabled) {
        background: var(--color-neon-cyan);
        color: #000;
        box-shadow: var(--shadow-neon-cyan);
    }

    .modal__test-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
