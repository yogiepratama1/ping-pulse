---
/**
 * Header.astro — Neo-Brutalist header with bold typography
 */
---

<header class="header">
    <div class="header__inner">
        <div class="header__logo-group">
            <div class="header__pulse-icon">
                <svg
                    viewBox="0 0 48 48"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="header__svg"
                >
                    <rect
                        x="2"
                        y="2"
                        width="44"
                        height="44"
                        stroke="#1A1A2E"
                        stroke-width="4"
                        fill="#FF6B35"></rect>
                    <polyline
                        points="4,24 12,24 16,10 22,38 28,16 34,32 38,24 44,24"
                        stroke="#1A1A2E"
                        stroke-width="3"
                        fill="none"
                        stroke-linejoin="round"></polyline>
                </svg>
            </div>
            <div class="header__text">
                <h1 class="header__title">PING PULSE</h1>
                <p class="header__tagline">Network Latency Tester</p>
            </div>
        </div>
        <div class="header__status">
            <span class="header__dot"></span>
            <span class="header__status-text">System Online</span>
        </div>
    </div>
</header>

<style>
    .header {
        border-bottom: 4px solid var(--color-border);
        background: var(--color-accent);
        padding: 1.2rem 2rem;
    }

    .header__inner {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header__logo-group {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header__pulse-icon {
        width: 52px;
        height: 52px;
        border: 3px solid var(--color-border);
        box-shadow: var(--shadow-brutal);
        background: var(--color-primary);
        overflow: hidden;
    }

    .header__svg {
        width: 100%;
        height: 100%;
    }

    .header__title {
        font-family: var(--font-display);
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: -0.02em;
        margin: 0;
        line-height: 1;
    }

    .header__tagline {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-text-secondary);
        letter-spacing: 0.05em;
        margin: 0.25rem 0 0;
        text-transform: uppercase;
    }

    .header__status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-bg-card);
        border: 3px solid var(--color-border);
        box-shadow: var(--shadow-brutal);
        padding: 0.5rem 1rem;
    }

    .header__dot {
        width: 10px;
        height: 10px;
        background: var(--color-success);
        border: 2px solid var(--color-border);
        border-radius: 50%;
        animation: pulse-dot 2s ease-in-out infinite;
    }

    .header__status-text {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--color-text-primary);
        letter-spacing: 0.05em;
    }

    @media (max-width: 640px) {
        .header {
            padding: 1rem;
        }
        .header__title {
            font-size: 1.6rem;
        }
    }
</style>
