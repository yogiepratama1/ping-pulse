---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import TargetCard from "../components/TargetCard.astro";
import Modal from "../components/Modal.astro";
import { query, initDb } from "../lib/db";
import type { PingTarget } from "../lib/db";

// Ensure table exists, then fetch targets
await initDb();
const targets = await query<PingTarget>(
	"SELECT * FROM ping_targets ORDER BY name ASC",
);
---

<BaseLayout>
	<Header />

	<main class="main">
		<div class="grid-header">
			<h2 class="grid-title">SELECT TARGET</h2>
			<p class="grid-subtitle">
				[ {targets.length} ENDPOINTS AVAILABLE ]
			</p>
		</div>

		<div class="grid">
			{
				targets.length > 0 ? (
					targets.map((target) => <TargetCard target={target} />)
				) : (
					<div class="empty-state">
						<p>NO TARGETS FOUND</p>
						<p class="empty-hint">
							Run `npm run seed` to populate the database
						</p>
					</div>
				)
			}
		</div>
	</main>

	<Modal />

	<footer class="footer">
		<p>PING PULSE v1.0 // CYBER-BRUTALIST NETWORK TERMINAL</p>
	</footer>
</BaseLayout>

<style>
	.main {
		max-width: 1400px;
		margin: 0 auto;
		padding: 2rem;
	}

	.grid-header {
		margin-bottom: 1.5rem;
		border-bottom: 2px solid rgba(0, 255, 245, 0.15);
		padding-bottom: 1rem;
	}

	.grid-title {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-neon-cyan);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		margin: 0;
	}

	.grid-subtitle {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: var(--color-neon-magenta);
		letter-spacing: 0.2em;
		margin: 0.3rem 0 0;
		opacity: 0.7;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	.empty-state {
		grid-column: 1 / -1;
		text-align: center;
		padding: 3rem;
		border: 2px dashed rgba(0, 255, 245, 0.2);
		font-family: var(--font-mono);
		color: var(--color-neon-cyan);
		font-size: 0.85rem;
		letter-spacing: 0.15em;
	}

	.empty-hint {
		font-size: 0.65rem;
		color: var(--color-neon-magenta);
		opacity: 0.6;
		margin-top: 0.5rem;
	}

	.footer {
		text-align: center;
		padding: 1.5rem;
		border-top: 2px solid rgba(0, 255, 245, 0.1);
		margin-top: 2rem;
	}

	.footer p {
		font-family: var(--font-mono);
		font-size: 0.55rem;
		color: var(--color-neon-cyan);
		letter-spacing: 0.25em;
		opacity: 0.3;
		margin: 0;
	}

	@media (max-width: 640px) {
		.main {
			padding: 1rem;
		}
		.grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
