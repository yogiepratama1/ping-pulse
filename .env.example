# Database configuration
# Set DB_TYPE to 'sqlite' (default) or 'postgres'
DB_TYPE=sqlite

# PostgreSQL connection string (only used if DB_TYPE=postgres)
DATABASE_URL=postgresql://pingpulse:pingpulse@localhost:5432/pingpulse

# Gemini API key (required for API ping targets)
GEMINI_API_KEY=your_gemini_key_here
